# RoomBook configuration (see README.md, "Configuration").
# Copy to .env and adjust; .env is never committed.

PORT=3000
DB_FILE=data/roombook.db
CAMPUS_TIME_ZONE=Europe/Helsinki
OPENING_HOURS=08:00-22:00
# Comma-separated list of email domains allowed to register.
ALLOWED_EMAIL_DOMAINS=uni.example
RATE_LIMIT_PER_MINUTE=300

# First administrator, created at start-up / by `npm run seed` if no account with this email exists.
# REQUIRED: set a password of 12–128 characters, not equal to the email address. Start-up refuses
# an empty password while ADMIN_EMAIL is set (remove ADMIN_EMAIL to start without an administrator).
ADMIN_EMAIL=admin@uni.example
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator
