{
  "name": "roombook",
  "version": "1.0.0",
  "private": true,
  "description": "RoomBook — campus study-room booking (spec 001-room-booking)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "purge": "node --env-file-if-exists=.env src/cli/purge.ts",
    "perf": "node scripts/perf.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:acceptance": "vitest run tests/acceptance",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
